# Copiar este archivo a ".env" y ajustar valores antes de levantar el proyecto

# MySQL
MYSQL_ROOT_PASSWORD=rootpass
DB_NAME=biblioteca
DB_USER=biblioteca_user
DB_PASSWORD=biblioteca_pass

# Flask
SECRET_KEY=cambia-esta-clave

# Agente (ADK) - necesita una API key de Google AI Studio para el modelo Gemini
ADK_MODEL=gemini-2.0-flash
GOOGLE_API_KEY=coloca_tu_api_key_aqui
