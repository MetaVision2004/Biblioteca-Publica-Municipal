# Copiar este archivo a ".env" y ajustar valores antes de levantar el proyecto

# Supabase PostgreSQL
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=TU_SUPABASE_ANON_KEY

# Flask
SECRET_KEY=TU_SECRET_KEY

# Agente (ADK)
ADK_MODEL=gemini-2.0-flash
GOOGLE_API_KEY=TU_GOOGLE_API_KEY

# Notificaciones opcionales
# SMTP (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=Biblioteca Pública Municipal
SMTP_PASSWORD=tu_password
SMTP_USE_TLS=true
SMTP_FROM=Biblioteca Pública Municipal <noreply@tu-dominio.com>

# Resend (alternativa)
RESEND_API_KEY=
EMAIL_FROM=Biblioteca Pública Municipal <onboarding@resend.dev>
